{
    "editor.fontLigatures": true,
    "editor.fontSize": 18,
    "editor.fontWeight": "normal",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.iconTheme": "material-icon-theme",
    "files.autoSave": "afterDelay",
    "workbench.startupEditor": "none",
    "editor.inlineSuggest.enabled": true,
    "editor.fontFamily": "Cartograph CF",
    "workbench.colorTheme": "Matugen Dynamic Theme",



    /* 🎨 THE MATUGEN COLOR KEY (ALL SLOTS) 🎨
       Contrast Levels (Backgrounds):
       - DEEPEST: #0b0e15
       - LOW:     #191b22
       - NORMAL:  #1d2026
       - HIGH:    #272a31
       - HIGHEST: #32353c
       
       Hue Categories (Accents):
       - PRIMARY: #adc6ff        (Main Theme)
       - SECONDARY: #b1c6f7    (Sub-Accents)
       - TERTIARY: #f4aeff      (Pop of color)
    */




    "workbench.colorCustomizations": {
        // --- BASE & WINDOW ---
        "focusBorder":                            "#adc6ff55",
        "foreground":                             "#e1e2eb",
        "widget.shadow":                          "#000000AA",
        "selection.background":                   "#adc6ff33",
        "descriptionForeground":                  "#c2c6d5AA",
        "errorForeground":                        "#ffb4ab",
        
        "window.activeBorder":                    "#adc6ff33",
        "window.inactiveBorder":                  "#00000000",
        
        // --- TEXT ---
        "textLink.foreground":                    "#adc6ff",
        "textLink.activeForeground":              "#d8e2ff",
        "textCodeBlock.background":               "#191b22",

        // --- BUTTONS & INPUT ---
        "button.background":                      "#adc6ff",
        "button.foreground":                      "#002e69",
        "button.hoverBackground":                 "#4d8efe",

        "input.background":                       "#272a3155",
        "input.foreground":                       "#e1e2eb",
        "input.border":                           "#42475333",

        // --- SCROLLBAR ---
        "scrollbarSlider.background":             "#adc6ff11",
        "scrollbarSlider.hoverBackground":        "#adc6ff22",
        "scrollbarSlider.activeBackground":       "#adc6ff44",

        // --- ACTIVITY BAR (The Tinted Sidebar) ---
        "activityBar.background":                 "#0a0a0a",
        "activityBar.foreground":                 "#adc6ff",
        "activityBar.inactiveForeground":         "#c2c6d566",
        "activityBar.border":                     "#00000000",
        "activityBar.activeBorder":               "#adc6ff",
        "activityBarBadge.background":            "#adc6ff",
        "activityBarBadge.foreground":            "#002e69",

        // --- SIDE BAR ---
        "sideBar.background":                     "#0b0e15CC",
        "sideBar.foreground":                     "#e1e2ebCC",
        "sideBar.border":                         "#00000000",
        "sideBarTitle.foreground":                "#adc6ffBB",
        "sideBarSectionHeader.background":        "#00000000",
        "sideBarSectionHeader.foreground":        "#e1e2eb",
        "sideBarSectionHeader.border":            "#00000000",

        // --- EDITOR & TABS ---
        "editorGroup.border":                     "#42475311",
        "editorGroupHeader.tabsBackground":       "#0a0a0a",
        "editorGroupHeader.tabsBorder":           "#00000000",
        
        "tab.activeBackground":                   "#121212",
        "tab.activeForeground":                   "#adc6ff",
        "tab.activeBorderTop":                    "#adc6ff",
        "tab.inactiveBackground":                 "#0a0a0a",
        "tab.inactiveForeground":                 "#c2c6d588",
        "tab.border":                             "#00000000",

        "editor.background":                      "#0b0e15CC",
        "editor.foreground":                      "#e1e2ebCC",
        "editorLineNumber.foreground":            "#c2c6d544",
        "editorLineNumber.activeForeground":      "#adc6ff",
        "editorCursor.foreground":                "#adc6ff",
        "editor.selectionBackground":             "#adc6ff33",
        "editor.lineHighlightBackground":         "#adc6ff15",
        "editor.lineHighlightBorder":             "#00000000",

        "editorGutter.background":                "#0f0f0f",
        "editorBracketHighlight.foreground1":     "#adc6ff",
        "editorBracketHighlight.foreground2":     "#b1c6f7",
        "editorBracketHighlight.foreground3":     "#f4aeff",

        // --- PANEL & STATUS BAR ---
        "panel.background":                       "#0a0a0a",
        "panel.border":                           "#42475322",
        "panelTitle.activeForeground":            "#adc6ff",
        "panelTitle.activeBorder":                "#adc6ff",

        "statusBar.background":                   "#adc6ff",
        "statusBar.foreground":                   "#002e69",
        "statusBar.border":                       "#4d8efe",
        "statusBar.noFolderBackground":           "#adc6ff",

        "titleBar.activeBackground":              "#050505",
        "titleBar.activeForeground":              "#e1e2eb",
        "titleBar.border":                        "#00000000"
    },

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": { "foreground": "#c2c6d577", "fontStyle": "italic" }
            },
            {
                "scope": ["keyword", "storage.type", "storage.modifier"],
                "settings": { "foreground": "#adc6ff", "fontStyle": "italic" }
            },
            {
                "scope": ["string", "constant.other.symbol", "punctuation.definition.string"],
                "settings": { "foreground": "#b1c6f7" }
            },
            {
                "scope": ["entity.name.function", "support.function"],
                "settings": { "foreground": "#f4aeff" }
            },
            {
                "scope": ["variable", "support.variable"],
                "settings": { "foreground": "#e1e2eb" }
            },
            {
                "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
                "settings": { "foreground": "#adc6ffBB" }
            },
            {
                "scope": ["constant.numeric", "constant.language"],
                "settings": { "foreground": "#b1c6f7AA" }
            }
        ]
    }
,
  "material-code.primaryColor": "#4285f4"
}
