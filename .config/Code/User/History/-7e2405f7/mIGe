FROM ubuntu:22.04

# 1. Install System Dependencies (ffmpeg, git, curl)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Install yt-dlp (as per manual instructions)
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
    && chmod a+rx /usr/local/bin/yt-dlp

# 3. Setup Working Directory
WORKDIR /app

# 4. Clone Repository (Contains the 'tct-linux' binary)
RUN git clone https://github.com/tct9428/tct .
# RUN git clone https://github.com/tct9428/tct .
COPY tct-linux .

# 5. Make binary executable
RUN chmod +x tct-linux

# 6. Command to run the bot
CMD ["./tct-linux"]