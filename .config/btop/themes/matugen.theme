# Main background (Keep empty so the terminal background fills the borders seamlessly)
theme[main_bg]=""

# Main text color
theme[main_fg]="#e2e2e2"

# Title color for boxes (Using primary so the category names stand out)
theme[title]="#91cdff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d1bfe7"

# Selected item background/foreground
theme[selected_bg]="#91cdff"
theme[selected_fg]="#003350"

# Inactive/disabled text (Softened so it doesn't compete with active data)
theme[inactive_fg]="#919191"

# Text atop graphs
theme[graph_text]="#c6c6c6"

# Background color of percentage meters (Slightly darker for better meter contrast)
theme[meter_bg]="#474747"

# Misc colors for processes box 
theme[proc_misc]="#b8c8d9"

# Box outline colors (Using standard outline for a clean, non-distracting UI)
theme[cpu_box]="#919191"
theme[mem_box]="#919191"
theme[net_box]="#919191"
theme[proc_box]="#919191"

# Divider lines (Dimmed to keep focus on the data)
theme[div_line]="#474747"

# Temperature graph colors
theme[temp_start]="#91cdff"
theme[temp_mid]="#b8c8d9"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#91cdff"
theme[cpu_mid]="#b8c8d9"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter
theme[free_start]="#004b72"
theme[free_mid]=""
theme[free_end]="#91cdff"

# Mem/Disk cached meter
theme[cached_start]="#394856"
theme[cached_mid]=""
theme[cached_end]="#b8c8d9"

# Mem/Disk available meter
theme[available_start]="#4e4162"
theme[available_mid]=""
theme[available_end]="#d1bfe7"

# Mem/Disk used meter
theme[used_start]="#93000a"
theme[used_mid]=""
theme[used_end]="#ffb4ab"

# Download/Upload/Process gradients
theme[download_start]="#91cdff"
theme[download_mid]="#b8c8d9"
theme[download_end]="#d1bfe7"

theme[upload_start]="#91cdff"
theme[upload_mid]="#b8c8d9"
theme[upload_end]="#d1bfe7"

theme[process_start]="#91cdff"
theme[process_mid]="#b8c8d9"
theme[process_end]="#d1bfe7"