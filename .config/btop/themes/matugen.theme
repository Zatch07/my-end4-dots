# Main background (Keep empty so the terminal background fills the borders seamlessly)
theme[main_bg]=""

# Main text color
theme[main_fg]="#e1e2eb"

# Title color for boxes (Using primary so the category names stand out)
theme[title]="#adc6ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#f4aeff"

# Selected item background/foreground
theme[selected_bg]="#adc6ff"
theme[selected_fg]="#002e69"

# Inactive/disabled text (Softened so it doesn't compete with active data)
theme[inactive_fg]="#8c909f"

# Text atop graphs
theme[graph_text]="#c2c6d5"

# Background color of percentage meters (Slightly darker for better meter contrast)
theme[meter_bg]="#424753"

# Misc colors for processes box 
theme[proc_misc]="#b1c6f7"

# Box outline colors (Using standard outline for a clean, non-distracting UI)
theme[cpu_box]="#8c909f"
theme[mem_box]="#8c909f"
theme[net_box]="#8c909f"
theme[proc_box]="#8c909f"

# Divider lines (Dimmed to keep focus on the data)
theme[div_line]="#424753"

# Temperature graph colors
theme[temp_start]="#adc6ff"
theme[temp_mid]="#b1c6f7"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#adc6ff"
theme[cpu_mid]="#b1c6f7"
theme[cpu_end]="#ffb4ab"

# Mem/Disk free meter
theme[free_start]="#4d8efe"
theme[free_mid]=""
theme[free_end]="#adc6ff"

# Mem/Disk cached meter
theme[cached_start]="#344972"
theme[cached_mid]=""
theme[cached_end]="#b1c6f7"

# Mem/Disk available meter
theme[available_start]="#c66dda"
theme[available_mid]=""
theme[available_end]="#f4aeff"

# Mem/Disk used meter
theme[used_start]="#93000a"
theme[used_mid]=""
theme[used_end]="#ffb4ab"

# Download/Upload/Process gradients
theme[download_start]="#adc6ff"
theme[download_mid]="#b1c6f7"
theme[download_end]="#f4aeff"

theme[upload_start]="#adc6ff"
theme[upload_mid]="#b1c6f7"
theme[upload_end]="#f4aeff"

theme[process_start]="#adc6ff"
theme[process_mid]="#b1c6f7"
theme[process_end]="#f4aeff"