;;; doom-matugen-theme.el --- A Doom theme generated by Matugen -*- lexical-binding: t; no-byte-compile: t; -*-

(require 'doom-themes)

(defgroup doom-matugen-theme nil
  "Options for the `doom-matugen' theme."
  :group 'doom-themes)

(def-doom-theme doom-matugen
  "A dark theme generated by Matugen"

  ((bg         '("#11131a" nil nil))
   (fg         '("#e1e2eb" nil nil))
   (fg-alt     '("#c2c6d5" nil nil))
   (bg-alt     '("#191b22" nil nil))
   (base0      '("#0b0e15" nil nil))
   (base1      '("#191b22" nil nil))
   (base2      '("#1d2026" nil nil))
   (base3      '("#272a31" nil nil))
   (base4      '("#32353c" nil nil))
   (base5      '("#8c909f" nil nil))
   (base6      '("#424753" nil nil))
   (base7      '("#4d8efe" nil nil))
   (base8      '("#000000" nil nil))
   (grey       base4)
   (red        '("#ffb4ab" nil nil))
   (orange     '("#f4aeff" nil nil))
   (green      '("#adc6ff" nil nil))
   (teal       '("#adc6ff" nil nil))
   (yellow     '("#b1c6f7" nil nil))
   (blue       '("#adc6ff" nil nil))
   (dark-blue  '("#344972" nil nil))
   (magenta    '("#f4aeff" nil nil))
   (violet     '("#f4aeff" nil nil))
   (cyan       '("#adc6ff" nil nil))
   (dark-cyan  '("#dae4ff" nil nil))

   ;; Face categories
   (highlight      blue)
   (vertical-bar   base1)
   (selection      dark-blue)
   (builtin        magenta)
   (comments       base5)
   (doc-comments   base6)
   (constants      orange)
   (functions      cyan)
   (keywords       blue)
   (methods        cyan)
   (operators      blue)
   (type           yellow)
   (strings        green)
   (variables      fg)
   (numbers        orange)
   (region         selection)
   (error          red)
   (warning        yellow)
   (success        green)
   (vc-modified    orange)
   (vc-added       green)
   (vc-deleted     red))

  ;; Extra faces
  ((org-level-1 :foreground blue :weight 'bold :height 1.3)
   (org-level-2 :foreground magenta :weight 'bold :height 1.2)
   (org-level-3 :foreground green :weight 'bold :height 1.1))

  ;; Extra variables
  ()
  )

(provide-theme 'doom-matugen)
;;; doom-matugen-theme.el ends here
